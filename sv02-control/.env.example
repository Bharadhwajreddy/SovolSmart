# ---------------------------------------------------------------------------
# Copy this file to `.env` and fill in real values.  Never commit `.env`.
# ---------------------------------------------------------------------------

# --- Required -------------------------------------------------------------

# Base URL of your OctoPrint instance, no trailing slash.
# If this app runs on the same machine as OctoPrint, localhost is fastest.
OCTOPRINT_URL=http://localhost:5000

# OctoPrint API key.
# Get it from: OctoPrint -> Settings -> API -> Global API Key,
# or better: Settings -> Application Keys -> generate one for "sv02-control".
OCTOPRINT_API_KEY=changeme

# Password used to log in to THIS app. Pick something long — this app is
# exposed to the internet through your tunnel.
APP_PASSWORD=changeme

# --- Camera ---------------------------------------------------------------

# MJPEG stream from the "IP Webcam" Android app on your phone.
# The app shows this address on its screen when you tap "Start server".
# You can paste that address exactly as shown — if you leave off the path,
# /video is added for you.
#
# The backend fetches this and relays it, so the phone only ever needs to be
# reachable from the machine running this app, never from the internet.
# Give the phone a static IP or a DHCP reservation, or this will change.
PHONE_CAMERA_URL=http://192.168.2.141:8080/video

# Single-frame snapshot URL from the same app. Used as a fallback when the
# continuous stream drops. Usually the /video URL with /shot.jpg instead.
# Leave blank to have it derived automatically from PHONE_CAMERA_URL.
PHONE_SNAPSHOT_URL=

# If your IP Webcam app has a username/password set, put them here.
CAMERA_USERNAME=
CAMERA_PASSWORD=

# --- Notifications (ntfy.sh) ----------------------------------------------

# Full topic URL. Pick an unguessable topic name — anyone who knows the
# topic can read your notifications. Install the "ntfy" app on your phone
# and subscribe to the same topic.
# Leave blank to disable push notifications (in-app banners still work).
NTFY_TOPIC_URL=https://ntfy.sh/sv02-a7f3k2p9-changeme

# Optional access token if you use a private/self-hosted ntfy server.
NTFY_TOKEN=

# --- Failure detection ----------------------------------------------------

# Temperature deviation (°C) from target that counts as an anomaly.
TEMP_DEVIATION_C=15

# How long (seconds) the deviation must persist before it fires.
TEMP_DEVIATION_SECONDS=30

# Set to true to automatically pause the print when an anomaly fires.
# Default is false: you get alerted, but nothing is paused without you.
AUTO_PAUSE_ON_ANOMALY=false

# --- Server ---------------------------------------------------------------

PORT=8088

# Secret used to sign login session cookies. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# If left blank a random one is generated at startup, which means every
# restart logs you out. Fine for testing, set it properly for real use.
SESSION_SECRET=

# How long a login lasts, in hours.
SESSION_HOURS=720

# Set to true only if you terminate TLS in front of this app (OctoEverywhere,
# Cloudflare Tunnel, nginx with HTTPS). Makes the session cookie Secure-only.
TRUST_PROXY_HTTPS=true

# Where the anomaly / event log is written.
LOG_FILE=./data/events.log
